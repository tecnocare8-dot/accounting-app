# データベース（Neon）。手元では postgresql://localhost:5432/accounting_app_dev
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Googleログイン（Google Cloud の OAuth クライアント）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32 で作る。ドライブ連携のトークンの暗号化にも使うので、変えると全員の再ログインが必要
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3200
# 使える人のGoogleアカウント（カンマ区切り）。空なら誰でもログインできる
ALLOWED_EMAILS=
# 手元の確認だけで使う擬似ドライブの置き場所（Vercel では無視される）
DRIVE_FAKE_DIR=
